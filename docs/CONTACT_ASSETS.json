  "routing": {
    "mode": "Live Swiss address/postcode/place geocoding with the original D3 vector-map design. Authenticated route calculation remains disabled until a server-side private key is configured.",
    "coverage": "CH",
    "geocoding": {
      "provider": "geo.admin.ch SearchServer",
      "endpoint": "https://api3.geo.admin.ch/rest/services/ech/SearchServer",
      "realPublicLocationChecksPassed": true,
      "maximumCandidates": 8,
      "automaticSelection": false
    },
    "basemap": {
      "renderer": "Existing D3 SVG renderer; restored original light background, pale blue water, muted green land, grey buildings and white roads.",
      "defaultGeometry": "public/kraken-contact/data/contact-map-data.json",
      "defaultGeometryUse": "Original supplied geometry is reused within its Schaffhausen extent for the approved initial appearance.",
      "dynamicProvider": "swisstopo official vector tiles",
      "dynamicEndpoint": "https://vectortiles.geo.admin.ch/tiles/ch.swisstopo.base.vt/v1.0.0/{z}/{x}/{y}.pbf",
      "publishedBounds": [
        3.57,
        44.18,
        13.66,
        48.88
      ],
      "minimumZoom": 0,
      "maximumZoom": 14,
      "maximumVisibleTiles": 16,
      "maximumParallelDownloads": 4,
      "maximumCachedDecodedTiles": 32,
      "maximumTileBytes": 2097152,
      "maximumRawFeaturesPerTile": 120000,
      "maximumSelectedFeaturesPerTile": 40000,
      "minorRoadDetailMinimumZoom": 12,
      "staleRequestsCancelled": true,
      "oldGeometryStretchedToNewLocations": false,
      "rasterWmsUsed": false,
      "decoderDependencies": {
        "@mapbox/vector-tile": "3.0.0",
        "pbf": "5.2.0",
        "@mapbox/point-geometry": "1.1.0"
      }
    },
    "directions": {
      "provider": "openrouteservice",
      "endpoint": "https://api.heigit.org/openrouteservice/v2/directions/driving-car/geojson",
      "privateServerVariable": "CONTACT_ROUTING_API_KEY",
      "configured": false,
      "authenticatedLiveRequestVerified": false,
      "mockProviderChecksPassed": true,
      "directionsRequestedIndependently": true,
      "automaticDemoFallback": false,
      "liveTraffic": false,
      "gpsTracking": false
    },
    "exampleDestinations": [
      "Bahnhof Schaffhausen",
      "Bahnhof Neuhausen",
      "Rheinfall"
    ],
    "precomputedMetricsUsedByLivePage": false,
