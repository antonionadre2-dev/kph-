# Payrexx payment gateway (get these from your Payrexx dashboard: Settings > API & Webhooks)
# PAYREXX_INSTANCE is your Payrexx subdomain, e.g. "krakenpfm" for krakenpfm.payrexx.com
PAYREXX_INSTANCE=
# PAYREXX_API_SECRET is the API secret/key shown in your Payrexx dashboard. Keep it private.
PAYREXX_API_SECRET=
APP_URL=
GEMINI_API_KEY=
# Optional server-side Kai model; code default: gemini-3.5-flash-lite.
# GEMINI_MODEL=gemini-3.5-flash-lite
GOOGLE_REVIEW_URL=
# Optional private, server-only HeiGIT/openrouteservice key for contact directions.
# Obtain it from https://account.heigit.org; never prefix it with VITE_ or expose it in public files.
# Without this key, Swiss address/postcode search works, but live directions report not_configured.
CONTACT_ROUTING_API_KEY=

# New calculator: disabled until the server's private durable services are configured.
BOOKING_ENABLED=false
BOOKING_TOKEN_SECRET=
# Admin credentials belong only in server secrets. Use ONE credential method:
FIREBASE_SERVICE_ACCOUNT_JSON=
# GOOGLE_APPLICATION_CREDENTIALS=/private/path/service-account.json
BOOKING_USE_APPLICATION_DEFAULT=false
# Defaults match firebase-applet-config.json; use the same provisioned database.
BOOKING_FIREBASE_PROJECT_ID=
BOOKING_FIREBASE_DATABASE_ID=
# Explicit mode required; test payments remain test_paid, never paid.
PAYREXX_MODE=
# Separate webhook signing secret, not the API secret above.
PAYREXX_WEBHOOK_SECRET=
# Transactional provider + verified sender. No browser-prefixed secrets.
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=
BOOKING_EMAIL_FROM=
RECOVERY_TOKEN_SECRET=
# Enable Firebase email-link auth + authorized production domain before enabling.
BOOKING_CUSTOMER_ACCESS_ENABLED=false
